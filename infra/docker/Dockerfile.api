# API de ALUX. Construir desde la raíz:  docker build -f infra/docker/Dockerfile.api -t alux-api .
FROM node:22-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production
# Certificados raíz extra (sólo si hay un proxy que inspecciona HTTPS; ver infra/docker/certs)
COPY infra/docker/certs/ /usr/local/share/ca-certificates/extra/
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates \
 && update-ca-certificates && rm -rf /var/lib/apt/lists/*
ENV NODE_EXTRA_CA_CERTS=/etc/ssl/certs/ca-certificates.crt
COPY package.json package-lock.json ./
COPY apps/api/package.json apps/api/
COPY apps/portal/package.json apps/portal/
COPY packages/shared-contracts/package.json packages/shared-contracts/
COPY tests/package.json tests/
RUN npm ci --omit=dev -w @alux/api -w @alux/shared-contracts
COPY packages packages
COPY apps/api apps/api
USER node
EXPOSE 4000
CMD ["npm", "run", "start", "-w", "@alux/api"]
