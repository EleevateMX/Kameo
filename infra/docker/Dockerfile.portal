# Portal de ALUX (incluye el juego exportado a Web).
# Construir desde la raíz:  docker build -f infra/docker/Dockerfile.portal -t alux-portal .

# 1) Exportar el juego con Godot
FROM debian:bookworm-slim AS game
# Certificados raíz extra (sólo si hay un proxy que inspecciona HTTPS; ver infra/docker/certs)
COPY infra/docker/certs/ /usr/local/share/ca-certificates/extra/
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl unzip libfontconfig1 \
 && update-ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY scripts/setup-godot.sh scripts/build-game.sh scripts/
COPY game game
RUN scripts/setup-godot.sh && scripts/build-game.sh

# 2) Compilar el portal
FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY infra/docker/certs/ /usr/local/share/ca-certificates/extra/
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates \
 && update-ca-certificates && rm -rf /var/lib/apt/lists/*
ENV NODE_EXTRA_CA_CERTS=/etc/ssl/certs/ca-certificates.crt
COPY package.json package-lock.json ./
COPY apps/api/package.json apps/api/
COPY apps/portal/package.json apps/portal/
COPY packages/shared-contracts/package.json packages/shared-contracts/
COPY tests/package.json tests/
RUN npm ci -w @alux/portal -w @alux/shared-contracts
COPY packages packages
COPY apps/portal apps/portal
COPY --from=game /src/apps/portal/public/game apps/portal/public/game
RUN npm run build -w @alux/portal

# 3) Ejecutar
FROM build AS run
ENV NODE_ENV=production
USER node
EXPOSE 3000
CMD ["npm", "run", "start", "-w", "@alux/portal"]
