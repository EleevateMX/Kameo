{
  "name": "alux",
  "private": true,
  "version": "0.1.0",
  "description": "ALUX: El Despertar de Kukulkán — aventura cooperativa 3D para navegador",
  "type": "module",
  "workspaces": ["apps/*", "packages/*", "tests"],
  "engines": { "node": ">=20.11" },
  "scripts": {
    "setup:godot": "scripts/setup-godot.sh",
    "build:game": "scripts/build-game.sh",
    "dev": "node scripts/dev.mjs",
    "dev:api": "npm run dev -w @alux/api",
    "dev:portal": "npm run dev -w @alux/portal",
    "dev:game-server": "scripts/run-game-server.sh",
    "test": "npm run test -w @alux/api && scripts/test-sim.sh && npm run test:protocol -w @alux/tests",
    "test:sim": "scripts/test-sim.sh",
    "test:deploy": "scripts/test-deploy.sh",
    "test:e2e": "npm run test:e2e -w @alux/tests",
    "test:flow": "npm run test:flow -w @alux/tests",
    "test:boss": "npm run test:boss -w @alux/tests",
    "test:cine": "npm run test:cine -w @alux/tests --",
    "test:audio": "npm run test:audio -w @alux/tests --",
    "test:fullscreen": "npm run test:fullscreen -w @alux/tests",
    "test:cine-coop": "npm run test:cine-coop -w @alux/tests",
    "migrate": "npm run migrate -w @alux/api --",
    "beta:invites": "npm run --silent beta:invites -w @alux/api --",
    "beta:metrics": "npm run --silent beta:metrics -w @alux/api --",
    "beta:check": "npm run --silent beta:check -w @alux/tests --",
    "beta:preflight": "npm run --silent beta:preflight -w @alux/tests --"
  }
}
