{
  "name": "alux",
  "private": true,
  "version": "0.1.0",
  "description": "ALUX: El Despertar de Kukulkán — aventura cooperativa 3D para navegador",
  "type": "module",
  "workspaces": ["apps/*", "packages/*", "tests"],
  "engines": { "node": ">=20.11" },
  "scripts": {
    "setup:godot": "scripts/setup-godot.sh",
    "build:game": "scripts/build-game.sh",
    "dev": "node scripts/dev.mjs",
    "dev:api": "npm run dev -w @alux/api",
    "dev:portal": "npm run dev -w @alux/portal",
    "dev:game-server": "scripts/run-game-server.sh",
    "test": "npm run test -w @alux/api && npm run test:protocol -w @alux/tests",
    "test:e2e": "npm run test:e2e -w @alux/tests"
  }
}
