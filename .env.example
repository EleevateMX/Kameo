# Copia este archivo como ".env" en la raíz del repositorio.
# Para probar en tu computadora no hace falta rellenar nada: sin Discord
# configurado se activa una "entrada de prueba" y los datos se guardan en un archivo.

# ── Discord (https://discord.com/developers/applications → tu app → OAuth2) ──
# En "Redirects" agrega exactamente:  <BASE_URL>/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# URL pública del portal (sin barra final). En producción debe ser https://
BASE_URL=http://localhost:3000

# ── Secretos (obligatorios en producción; genera cada uno con: openssl rand -hex 32) ──
SESSION_SECRET=
GAME_TICKET_SECRET=
SERVICE_KEY=

# ── Base de datos (Supabase → Project Settings → Database → Connection string) ──
# Vacío = archivo local apps/api/data/dev-store.json (sólo para desarrollo)
DATABASE_URL=

# ── Servidores de juego: id=URL pública WebSocket, separados por coma ──
# En producción usa wss:// detrás del proxy, p. ej.  gs-1=wss://alux.midominio.com/ws
GAME_SERVERS=local-1=ws://localhost:9080

# ── Puertos internos ──
API_PORT=4000
GAME_PORT=9080
API_URL=http://127.0.0.1:4000

# Entrada de prueba sin Discord: true / false (por defecto, sólo si Discord no está configurado)
# ALLOW_DEV_LOGIN=false

# ── Sólo para Docker (infra/docker/docker-compose.yml) ──
# Dominio público que apunta a tu servidor
DOMAIN=
